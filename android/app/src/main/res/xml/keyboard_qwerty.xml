<?xml version="1.0" encoding="utf-8"?>
<!-- 云五笔主键盘 v0.4.6：严格对齐参考截图（放大核验版）
     行1: Q W E R T Y U I O P（10键，上滑数字1-0）
     行2: A S D F G H J K L（9键居中，上滑符号~@#$%&*()）
     行3: ↑(Shift) Z X C V B N M ⌫(退格宽)
     行4: 123 | 中/英 | !, | 🎤 | ?。 | 符 | ←(回车宽)
     功能键浅紫底 #C8C8D8，普通键白底，键盘底 #E8EBEF -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="8.3%p"
    android:keyHeight="57.5dp"
    android:horizontalGap="0.55%p"
    android:verticalGap="3dp"
    android:keyBackground="@drawable/key_bg">

    <!-- 行1：Q W E R T Y U I O P（上滑数字 1 2 3 4 5 6 7 8 9 0） -->
    <Row>
        <Key android:codes="113" android:keyLabel="Q" android:popupCharacters="1" />
        <Key android:codes="119" android:keyLabel="W" android:popupCharacters="2" />
        <Key android:codes="101" android:keyLabel="E" android:popupCharacters="3" />
        <Key android:codes="114" android:keyLabel="R" android:popupCharacters="4" />
        <Key android:codes="116" android:keyLabel="T" android:popupCharacters="5" />
        <Key android:codes="121" android:keyLabel="Y" android:popupCharacters="6" />
        <Key android:codes="117" android:keyLabel="U" android:popupCharacters="7" />
        <Key android:codes="105" android:keyLabel="I" android:popupCharacters="8" />
        <Key android:codes="111" android:keyLabel="O" android:popupCharacters="9" />
        <Key android:codes="112" android:keyLabel="P" android:popupCharacters="0" />
    </Row>

    <!-- 行2：A S D F G H J K L（上滑符号 ~ @ # $ % & * ( )） -->
    <Row android:keyWidth="9.2%p" android:horizontalGap="0.6%p">
        <Key android:codes="97" android:keyLabel="A" android:popupCharacters="~" />
        <Key android:codes="115" android:keyLabel="S" android:popupCharacters="@" />
        <Key android:codes="100" android:keyLabel="D" android:popupCharacters="#" />
        <Key android:codes="102" android:keyLabel="F" android:popupCharacters="$" />
        <Key android:codes="103" android:keyLabel="G" android:popupCharacters="%" />
        <Key android:codes="104" android:keyLabel="H" android:popupCharacters="&amp;" />
        <Key android:codes="106" android:keyLabel="J" android:popupCharacters="*" />
        <Key android:codes="107" android:keyLabel="K" android:popupCharacters="(" />
        <Key android:codes="108" android:keyLabel="L" android:popupCharacters=")" />
    </Row>

    <!-- 行3：↑Shift | Z X C V B N M | ⌫退格（宽） -->
    <Row android:keyWidth="8.4%p" android:horizontalGap="0.55%p">
        <Key android:codes="-105" android:keyLabel="↑" android:keyWidth="12%p" />
        <Key android:codes="122" android:keyLabel="Z" />
        <Key android:codes="120" android:keyLabel="X" />
        <Key android:codes="99" android:keyLabel="C" />
        <Key android:codes="118" android:keyLabel="V" />
        <Key android:codes="98" android:keyLabel="B" />
        <Key android:codes="110" android:keyLabel="N" />
        <Key android:codes="109" android:keyLabel="M" android:popupCharacters="、" />
        <Key android:codes="-5" android:keyLabel="←" android:keyWidth="14%p" android:isRepeatable="true" />
    </Row>

    <!-- 行4：123 | 中/英 | !, | 空格(原🎤，v0.4.8反馈⑤) | ?。 | 符 | ←(回车宽) -->
    <Row android:keyWidth="9%p" android:horizontalGap="0.9%p">
        <Key android:codes="-101" android:keyLabel="123" />
        <Key android:codes="-102" android:keyLabel="中" />
        <Key android:codes="-106" android:keyLabel="！&#10;，" android:popupCharacters="!" />
        <Key android:codes="-107" android:keyLabel="空格" android:keyWidth="24%p" />
        <Key android:codes="-108" android:keyLabel="？&#10;。" android:popupCharacters="?" />
        <Key android:codes="-104" android:keyLabel="符" />
        <Key android:codes="-4" android:keyLabel="↲" android:keyWidth="13%p" />
    </Row>
</Keyboard>
