<?xml version="1.0" encoding="utf-8"?>
<!-- 云五笔主键盘：3行字母 + 功能行（对齐主流输入法布局，深色主题） -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="48dp"
    android:horizontalGap="1.5%p"
    android:verticalGap="4dp"
    android:keyBackground="@drawable/key_bg">

    <!-- 行1：q w e r t y u i o p -->
    <Row android:keyWidth="10%p">
        <Key android:codes="113" android:keyLabel="q" android:keyTextColor="#FFFFFF" />
        <Key android:codes="119" android:keyLabel="w" android:keyTextColor="#FFFFFF" />
        <Key android:codes="101" android:keyLabel="e" android:keyTextColor="#FFFFFF" />
        <Key android:codes="114" android:keyLabel="r" android:keyTextColor="#FFFFFF" />
        <Key android:codes="116" android:keyLabel="t" android:keyTextColor="#FFFFFF" />
        <Key android:codes="121" android:keyLabel="y" android:keyTextColor="#FFFFFF" />
        <Key android:codes="117" android:keyLabel="u" android:keyTextColor="#FFFFFF" />
        <Key android:codes="105" android:keyLabel="i" android:keyTextColor="#FFFFFF" />
        <Key android:codes="111" android:keyLabel="o" android:keyTextColor="#FFFFFF" />
        <Key android:codes="112" android:keyLabel="p" android:keyTextColor="#FFFFFF" />
    </Row>

    <!-- 行2：a s d f g h j k l -->
    <Row android:keyWidth="11.11%p">
        <Key android:codes="97" android:keyLabel="a" android:keyTextColor="#FFFFFF" />
        <Key android:codes="115" android:keyLabel="s" android:keyTextColor="#FFFFFF" />
        <Key android:codes="100" android:keyLabel="d" android:keyTextColor="#FFFFFF" />
        <Key android:codes="102" android:keyLabel="f" android:keyTextColor="#FFFFFF" />
        <Key android:codes="103" android:keyLabel="g" android:keyTextColor="#FFFFFF" />
        <Key android:codes="104" android:keyLabel="h" android:keyTextColor="#FFFFFF" />
        <Key android:codes="106" android:keyLabel="j" android:keyTextColor="#FFFFFF" />
        <Key android:codes="107" android:keyLabel="k" android:keyTextColor="#FFFFFF" />
        <Key android:codes="108" android:keyLabel="l" android:keyTextColor="#FFFFFF" />
    </Row>

    <!-- 行3：符号 ?! + z x c v b n m + 删除 -->
    <Row android:keyWidth="9%p">
        <Key android:codes="-103" android:keyLabel="？" android:keyTextColor="#9CA3AF" />
        <Key android:codes="122" android:keyLabel="z" android:keyTextColor="#FFFFFF" />
        <Key android:codes="120" android:keyLabel="x" android:keyTextColor="#FFFFFF" />
        <Key android:codes="99" android:keyLabel="c" android:keyTextColor="#FFFFFF" />
        <Key android:codes="118" android:keyLabel="v" android:keyTextColor="#FFFFFF" />
        <Key android:codes="98" android:keyLabel="b" android:keyTextColor="#FFFFFF" />
        <Key android:codes="110" android:keyLabel="n" android:keyTextColor="#FFFFFF" />
        <Key android:codes="109" android:keyLabel="m" android:keyTextColor="#FFFFFF" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyTextColor="#9CA3AF" android:isRepeatable="true" />
    </Row>

    <!-- 行4：功能行 123 | 中/英 | ， | 。 | 空格 | 回车 -->
    <Row android:keyWidth="10%p" android:keyHeight="44dp">
        <Key android:codes="-101" android:keyLabel="123" android:keyTextColor="#9CA3AF" />
        <Key android:codes="-102" android:keyLabel="中/英" android:keyTextColor="#60A5FA" />
        <Key android:codes="44" android:keyLabel="，" android:keyTextColor="#FFFFFF" />
        <Key android:codes="46" android:keyLabel="。" android:keyTextColor="#FFFFFF" />
        <Key android:codes="32" android:keyLabel="空格" android:keyWidth="30%p" android:keyTextColor="#9CA3AF" />
        <Key android:codes="-4" android:keyLabel="↵" android:keyTextColor="#60A5FA" />
    </Row>
</Keyboard>
