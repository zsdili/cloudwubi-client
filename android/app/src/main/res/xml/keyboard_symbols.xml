<?xml version="1.0" encoding="utf-8"?>
<!-- 云五笔数字/符号键盘：123 切换面板 -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="48dp"
    android:horizontalGap="1.5%p"
    android:verticalGap="4dp"
    android:keyBackground="@drawable/key_bg">

    <!-- 行1：数字 -->
    <Row android:keyWidth="10%p">
        <Key android:codes="49" android:keyLabel="1" android:keyTextColor="#FFFFFF" />
        <Key android:codes="50" android:keyLabel="2" android:keyTextColor="#FFFFFF" />
        <Key android:codes="51" android:keyLabel="3" android:keyTextColor="#FFFFFF" />
        <Key android:codes="52" android:keyLabel="4" android:keyTextColor="#FFFFFF" />
        <Key android:codes="53" android:keyLabel="5" android:keyTextColor="#FFFFFF" />
        <Key android:codes="54" android:keyLabel="6" android:keyTextColor="#FFFFFF" />
        <Key android:codes="55" android:keyLabel="7" android:keyTextColor="#FFFFFF" />
        <Key android:codes="56" android:keyLabel="8" android:keyTextColor="#FFFFFF" />
        <Key android:codes="57" android:keyLabel="9" android:keyTextColor="#FFFFFF" />
        <Key android:codes="48" android:keyLabel="0" android:keyTextColor="#FFFFFF" />
    </Row>

    <!-- 行2：常用符号 -->
    <Row android:keyWidth="10%p">
        <Key android:codes="45" android:keyLabel="-" android:keyTextColor="#FFFFFF" />
        <Key android:codes="47" android:keyLabel="/" android:keyTextColor="#FFFFFF" />
        <Key android:codes="58" android:keyLabel=":" android:keyTextColor="#FFFFFF" />
        <Key android:codes="59" android:keyLabel=";" android:keyTextColor="#FFFFFF" />
        <Key android:codes="40" android:keyLabel="(" android:keyTextColor="#FFFFFF" />
        <Key android:codes="41" android:keyLabel=")" android:keyTextColor="#FFFFFF" />
        <Key android:codes="64" android:keyLabel="@" android:keyTextColor="#FFFFFF" />
        <Key android:codes="35" android:keyLabel="#" android:keyTextColor="#FFFFFF" />
        <Key android:codes="95" android:keyLabel="_" android:keyTextColor="#FFFFFF" />
        <Key android:codes="38" android:keyLabel="&amp;" android:keyTextColor="#FFFFFF" />
    </Row>

    <!-- 行3：中文标点 -->
    <Row android:keyWidth="10%p">
        <Key android:codes="63" android:keyLabel="？" android:keyTextColor="#FFFFFF" />
        <Key android:codes="33" android:keyLabel="！" android:keyTextColor="#FFFFFF" />
        <Key android:codes="44" android:keyLabel="，" android:keyTextColor="#FFFFFF" />
        <Key android:codes="46" android:keyLabel="。" android:keyTextColor="#FFFFFF" />
        <Key android:codes="8226" android:keyLabel="·" android:keyTextColor="#FFFFFF" />
        <Key android:codes="183" android:keyLabel="·" android:keyTextColor="#FFFFFF" />
        <Key android:codes="34" android:keyLabel="&quot;" android:keyTextColor="#FFFFFF" />
        <Key android:codes="39" android:keyLabel="'" android:keyTextColor="#FFFFFF" />
        <Key android:codes="42" android:keyLabel="*" android:keyTextColor="#FFFFFF" />
        <Key android:codes="37" android:keyLabel="%" android:keyTextColor="#FFFFFF" />
    </Row>

    <!-- 行4：功能（返回字母 | 空格 | 删除） -->
    <Row android:keyWidth="10%p" android:keyHeight="44dp">
        <Key android:codes="-103" android:keyLabel="返回" android:keyTextColor="#60A5FA" />
        <Key android:codes="32" android:keyLabel="空格" android:keyWidth="70%p" android:keyTextColor="#9CA3AF" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyTextColor="#9CA3AF" android:isRepeatable="true" />
    </Row>
</Keyboard>
